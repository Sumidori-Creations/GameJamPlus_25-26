[sub_resource type="GDScript" id="GDScript_73s2y"]
script/source = "@tool
extends Area2D

@onready var sprite := $Sprite

@export var item_name = \"bear\"
@export var stack_limit = 99
@export var amount = 1
var pickable = true

@export var image: Texture2D:
	set(value):
		image = value
		if Engine.is_editor_hint():
			call_deferred(\"_apply_image\")
		else:
			if sprite:
				sprite.texture = value

func _apply_image():
	$Sprite.texture = image
		
func _ready() -> void:
	_apply_image()

func _on_area_exited(_area: Area2D) -> void:
	pickable = true
"

