[sub_resource type="GDScript" id="GDScript_gihnv"]
script/source = "extends Control  # Supongamos que este script está en un nodo Control que es tu caja de diálogo

@export var typing_speed := 0.05  # segundos por letra
@export var max_length := 400
@export var max_height := 80

var min_length : float
var min_height : float
var full_text := \"\"
var display_text := \"\"
var char_index := 0
var typing := false
var font : Font

@onready var label = $Bubble/Text
@onready var bubble = $Bubble

func _ready() -> void:
	font = label.get_theme_font(\"font\")
	min_height = font.get_height() + bubble.patch_margin_left + bubble.patch_margin_right
	min_length = font.get_string_size(\"Hola\").x + bubble.patch_margin_bottom + bubble.patch_margin_top
	if bubble.size.x < min_length:
		bubble.size.x = min_length
	if bubble.size.y < min_height:
		bubble.size.y = min_height
	label.size.x = bubble.size.x - bubble.patch_margin_right
	label.size.y = bubble.size.y - bubble.patch_margin_bottom

func show_text(text: String) -> void:
	full_text = text
	display_text = \"\"
	char_index = 0
	typing = true
	label.text = \"\"  # limpiar al principio

func _process(_delta: float) -> void:
	if typing:
		# cada ciclo agregamos letra si hay más
		if char_index < full_text.length():
			char_index += 1
			# dividimos el texto hasta el índice actual
			display_text = full_text.substr(0, char_index)
			label.text = display_text
			handle_autoWrap()
		else:
			# ya terminamos de escribir todo
			typing = false

func handle_autoWrap():
	var text_length = font.get_string_size(label.text).x
	if label.size.x < text_length:
		var difference = abs(text_length - label.size.x)
		if difference + bubble.size.x <= max_length:
			bubble.size.x += difference
			label.size.x += difference
	var text_height = label.get_line_count() * font.get_height()
	if label.size.y < text_height:
		var difference = abs(text_height - label.size.y)
		if difference + bubble.size.y <= max_height:
			bubble.size.y += difference
			label.size.y += difference

func _input(event):
	# si el jugador presiona una tecla (ejemplo: espacio), y aún está escribiendo, saltar al final
	if event.is_action_pressed(\"ui_accept\"):
		if typing:
			label.text = full_text
			typing = false
		else:
			# aquí podrías avisar que termine la línea y pasar a la siguiente
			emit_signal(\"text_done\")  # por ejemplo
			show_text(\"Hola mundo, esta es una prueba para la funcionalidad de chat.\")
"

