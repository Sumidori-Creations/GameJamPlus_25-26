[gd_scene load_steps=3 format=3 uid="uid://bv6y3t7507ov8"]

[ext_resource type="FontFile" uid="uid://ced6iug8fx23p" path="res://Assets/UI/Fonts/Abbasy Calligraphy Typeface.ttf" id="1_cg7vp"]

[sub_resource type="GDScript" id="GDScript_cg7vp"]
script/source = "extends CanvasLayer

@onready var unpauseButton = $unpauseButton
@onready var restartButton = $restartButton
@onready var exitButton = $exitButton

@export var actualScene : String

func _ready() -> void:
	unpauseButton.grab_focus()

func _input(event: InputEvent) -> void:
	if event.is_action_pressed(\"open_inventory\") and Global.state != Global.GameState.CINEMATIC:
		get_tree().paused = true
		self.process_mode = Node.PROCESS_MODE_ALWAYS
		Global.state = Global.GameState.MENU
		self.visible = true
		unpauseButton.grab_focus()

func _on_unpause_button_pressed() -> void:
	get_tree().paused = false
	Global.state = Global.GameState.PLAYING
	self.visible = false

func _on_restart_button_pressed() -> void:
	restartButton.release_focus()
	AudioServer.set_bus_mute(AudioServer.get_bus_index(\"Master\"), true)
	Global.transitionTo(actualScene, self)
	get_tree().paused = false

func _on_exit_button_pressed() -> void:
	exitButton.release_focus()
	AudioServer.set_bus_mute(AudioServer.get_bus_index(\"Master\"), true)
	Global.transitionTo(\"res://Scenes/main_menu.tscn\", self)
	get_tree().paused = false
"

