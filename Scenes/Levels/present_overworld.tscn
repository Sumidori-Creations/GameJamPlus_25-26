[sub_resource type="GDScript" id="GDScript_gf4md"]
script/source = "extends Node2D

@onready var camera = $Camera2D
@onready var player = $Player
@onready var inventory = $Camera2D/Inventory
@onready var cinematic_bars = $CinematicBars
@onready var event_manager = $Events

func _ready() -> void:
	camera.position = player.position
	player.pickup_item.connect(add_item)
	cinematic_bars.end()

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	camera.position = player.position
	pass

func add_item(area: Area2D) -> void:
	inventory.add_item(area)
	pass

func _on_level_exit_body_entered(_body: Node2D) -> void:
	Global.state = Global.GameState.CINEMATIC
	Global.transitionTo(\"res://Scenes/Levels/train_found.tscn\", self)

func _on_conversation_body_entered(body: Node2D) -> void:
	if body.name != \"Player\": return
	Global.state = Global.GameState.CINEMATIC
	cinematic_bars.start()
	event_manager.get_node(\"conversation\").queue_free()
"

