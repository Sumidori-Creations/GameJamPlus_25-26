[sub_resource type="GDScript" id="GDScript_b3osi"]
script/source = "extends Node2D

@export var player_position : Vector2

@onready var player : CharacterBody2D = $Player
@onready var inventory = $UI/Inventory
@onready var cinematic_bars = $CinematicBars
@onready var toast : timeZoneToast = $timeZoneToast

func _ready() -> void:
	player.pickup_item.connect(add_item)
	cinematic_bars.end()
	player.position = player_position
	toast.show_toast()

func add_item(area: Area2D) -> void:
	inventory.add_item(area)
	pass

func _on_area_2d_body_entered(_body: Node2D) -> void:
	Global.state = Global.GameState.CINEMATIC
	Global.transitionTo(\"res://Scenes/Levels/first_train_repair.tscn\", self)
"

