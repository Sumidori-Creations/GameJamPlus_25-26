[sub_resource type="GDScript" id="GDScript_nti2j"]
script/source = "extends Node2D

@onready var camera = $Camera2D
@onready var player = $PlayerTest
@onready var inventory = $Camera2D/Inventory

func _ready() -> void:
	player.pickup_item.connect(add_item)

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	camera.position = player.position
	pass

func add_item(area: Area2D) -> void:
	inventory.add_item(area)
	pass
"

